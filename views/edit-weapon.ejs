<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%=title%></title>
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<%- include('./partials/header') %>
		
		<h1>THIS iS EDIT WEAPONS</h1>
		<% if (locals.errors) { %>
			<%- include("./partials/errors") %>
		<%}  %>
		<form action="/edit-weapon/<%=weapon.id%>" method="POST">
			<div class="form-container">
				<div class="left">
					<section>
						<div class="input-label">
							<label for="name">Name:</label>
							<input type="text" name="name" id="name" minlength="1" maxlength="30" value="<%=weapon.name%>" required >
						</div>
					</section>
					<section>
						<div class="input-label">
							<label for="price">Price(in g):</label>
							<input type="number" name="price" id="price" max="99999" value="<%=weapon.price%>" required>
						</div>
						<div class="input-label">
							<label for="quantity">Quantity:</label>
							<input type="number" name="quantity" id="quantity" max="99999" value="<%=weapon.quantity%>" required>
						</div>
					</section>
					<section>
						<div class="input-label">
							<label for="tier">Tier:</label>
							<select name="tier" id="tier"  required>
								<option value=""  >What tier is your weapon?</option>
								<option value="1" <% if (weapon.tier === 1) { %> selected <% } %> >1</option>
								<option value="2" <% if (weapon.tier === 2) { %> selected <% } %> >2</option>
								<option value="3" <% if (weapon.tier === 3) { %> selected <% } %> >3</option>
							</select>
						</div>
						<div class="input-label">
							<label for="type">Type:</label>
							<select name="type" id="type" required>
								<option value="">What type of weapon is your weapon?</option>
								<option value="1" <% if (weapon.type_id === 1) { %> selected <% } %>>Sword</option>
								<option value="2" <% if (weapon.type_id === 2) { %> selected <% } %>>Double Headed Axe</option>
								<option value="3" <% if (weapon.type_id === 3) { %> selected <% } %>>Mace</option>
								<option value="4" <% if (weapon.type_id === 4) { %> selected <% } %>>Single Headed Axe</option>
								<option value="5" <% if (weapon.type_id === 5) { %> selected <% } %>>Staff</option>
							</select>
						</div>
					</section>
				</div>
				<div class="right">
					<h2>Image:</h2>
					<div class="img-box">
						<% for (let i = 0; i < weaponImagePaths.length; i++ ) { %>
							<% const img = weaponImagePaths[i] %>
							<input type="radio" name="image" id="image<%=i%>" class="image-radio" value="<%=img%>" <% if (weapon.img === img) { %> checked <% } %>required>
							<label for="image<%=i%>" class="radio-label <%= weapon.img === img ? 'selected' : ''%>">
								<img src="<%=img%>" alt="<%=img%>">
							</label>
				
						<%} %>
					</div>
				</div>
			</div>
			
			<div class="button-wrapper">
				<button type="submit">Submit</button>
				<button type="button" class="delete-button">Delete</button>
			</div>
		</form>
		
	</body>
	<script>
		const labels = document.querySelectorAll(".img-box label");
		labels.forEach(label =>  {
			label.addEventListener("click", (e) => {
				labels.forEach((label) => {
					label.classList.remove("selected");
				})
				label.classList.add("selected");
			});
		});
		const deleteButton = document.querySelector('.delete-button');
		deleteButton.addEventListener('click', () => {
			fetch('/delete/<%=weapon.id%>', {
				method: 'DELETE',
			}).then((response) => {
				window.location.href = response.url;
			});
		});
	</script>
</html>
